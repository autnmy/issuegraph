{
  "name": "@issuegraph/core",
  "version": "0.1.0",
  "description": "The Issuegraph format's shared vocabulary as frozen constants and derived types \u2014 field names, cardinality, defaults and value sets. No parsing, no I/O. The reader, the writer and the viewer all read the format through this.",
  "keywords": [
    "issuegraph",
    "dependency-graph",
    "backlog",
    "scheduling",
    "frontmatter"
  ],
  "license": "Apache-2.0",
  "author": "Autonomy LLC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autnmy/issuegraph.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/autnmy/issuegraph#readme",
  "bugs": {
    "url": "https://github.com/autnmy/issuegraph/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
