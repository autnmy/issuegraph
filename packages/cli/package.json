{
  "name": "@issuegraph/cli",
  "version": "0.1.1",
  "description": "One command over the Issuegraph packages: read the block out of an issue body, derive the selection order from bodies you supply, and edit the block in place. Composes the reader, derive and writer packages; parses nothing itself, fetches nothing, and takes no credential.",
  "keywords": [
    "issuegraph",
    "dependency-graph",
    "backlog",
    "scheduling",
    "cli",
    "frontmatter"
  ],
  "license": "Apache-2.0",
  "author": "Autonomy LLC",
  "type": "module",
  "bin": {
    "issuegraph": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/bin.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autnmy/issuegraph.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/autnmy/issuegraph#readme",
  "bugs": {
    "url": "https://github.com/autnmy/issuegraph/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@issuegraph/core": "workspace:^",
    "@issuegraph/derive": "workspace:^",
    "@issuegraph/reader": "workspace:^",
    "@issuegraph/writer": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
