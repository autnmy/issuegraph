{
  "name": "@issuegraph/writer",
  "version": "0.1.0",
  "description": "Write the Issuegraph frontmatter block into an issue body — render a fresh block, splice generated edges in place without disturbing anything else, and re-delimit a block a fence left inert. Pure string work; no network, no tracker, no reads.",
  "keywords": [
    "issuegraph",
    "dependency-graph",
    "backlog",
    "scheduling",
    "frontmatter",
    "serializer"
  ],
  "license": "Apache-2.0",
  "author": "Autonomy LLC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autnmy/issuegraph.git",
    "directory": "packages/writer"
  },
  "homepage": "https://github.com/autnmy/issuegraph#readme",
  "bugs": {
    "url": "https://github.com/autnmy/issuegraph/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@issuegraph/core": "workspace:^",
    "@issuegraph/reader": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
