# The workspace links packages during development; CI installs from the lockfile.
link-workspace-packages=true
# A published package must never depend on a workspace protocol specifier that
# npm cannot resolve — pnpm rewrites `workspace:` on publish, and this makes that
# explicit rather than incidental.
save-workspace-protocol=rolling
# Publishes are scoped and public by default; each package still declares it.
access=public
